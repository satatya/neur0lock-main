# Copy to .env and adjust as needed
DB_HOST=127.0.0.1
# docker-compose maps the MySQL container to host port 3307
DB_PORT=3307
DB_USER=app
DB_PASSWORD=app123
DB_NAME=neurolock

# 32-byte KEK (hex). MUST be identical to KEK_HEX in neurolock-staff-backend/.env,
# otherwise notes written here cannot be read by the API (and vice versa).
# Generate: python -c "import os, binascii; print(binascii.hexlify(os.urandom(32)).decode())"
KEK_HEX=replace-with-64-hex-characters
