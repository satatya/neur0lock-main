# Secrets for `docker compose up`. Create .env with random values: node scripts/setup-env.mjs
# (or copy this file to .env and fill it in by hand). Never commit .env.

# MySQL (clinical records)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app

# OpenLDAP directory administrator (used by the AAA server only)
LDAP_ADMIN_PASSWORD=change-me-ldap

# AAA server: Fernet key that encrypts TOTP secrets at rest
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AAA_SECRET_KEY=

# 256-bit key-encryption key (64 hex chars) for the encrypted therapy notes. BACK IT UP.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEK_HEX=

# Demo accounts (admin, psychiatrist, psychologist, therapist, nurse, patient) and demo notes
SEED_DEMO=true
DEMO_PASSWORD=Demo@1234

# Allowed browser origins for the API (* = any; the website itself is same-origin via nginx)
CORS_ORIGINS=*
