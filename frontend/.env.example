# NeuroLock frontend configuration (copy to .env and restart `npm start`).
#
# Usually you do NOT need this: in development the app talks to port 4311 on the machine
# that runs the Expo/Metro bundler, which works for Expo Go on a phone, emulators and web.
#
# Set it only to point at a different server, e.g. a deployed API:
# EXPO_PUBLIC_API_URL=https://neurolock.example.org/api
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4311/api
