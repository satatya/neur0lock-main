# Copy to .env and adjust. Never commit the real .env.
# (docker compose at the repository root sets all of this for you; this file is for running the API
#  directly with `npm run dev`.)

# MySQL - clinical data only (user-space/WSL or docker MySQL on host port 3307)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=app
MYSQL_PASSWORD=app123
MYSQL_DATABASE=neurolock

# 256-bit key-encryption key (hex) used to wrap the per-note data keys of encrypted therapy notes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match KEK_HEX in backend/sql-dbms-bundle/sql-dbms/app/.env if you use the Python client.
# Back it up: notes encrypted with it cannot be read without it.
KEK_HEX=replace-with-64-hex-characters

# AAA server (authentication, authorization, accounting) - HTTPS with mutual TLS.
# Local dev certificates: python infra/certs/generate_certs.py infra/certs/dev
# Local AAA server:       python aaa-server/dev_server.py --certs infra/certs/dev   (port 8443)
AAA_URL=https://localhost:8443
AAA_CA_FILE=../infra/certs/dev/ca.crt
AAA_CLIENT_CERT=../infra/certs/dev/api.crt
AAA_CLIENT_KEY=../infra/certs/dev/api.key

# Server
PORT=4311
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed browser origins, or * for any (development)
CORS_ORIGINS=*
# Set to true when running behind a reverse proxy (nginx in docker compose). X-Forwarded-For is then
# honoured only from TRUST_PROXY_HOSTS (comma-separated hostnames or IPs of the proxy, e.g. web or
# 127.0.0.1); every other caller is identified by its own address.
TRUST_PROXY=false
TRUST_PROXY_HOSTS=

# Seed the encrypted demo therapy notes on startup when the notes table is empty
SEED_DEMO=true
